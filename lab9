import numpy as np

def longest_even_subsequence(arr):
    #булевая маска чётности массива
    even_mask=(arr%2==0)
    #cumsum - накопленная сумма значений (флагов чётности)
    return np.max(np.cumsum(even_mask) - np.maximum.accumulate(np.cumsum(~even_mask)))


arr = np.array([2,4,6,8,10,12,16,18,20])
print(longest_even_subsequence(arr))
