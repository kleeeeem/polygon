void combSort(std::vector<int>& arr) {
    int n = arr.size();
    int gap = n;
    bool swapped = true;

    while (gap != 1 || swapped) {
        gap = std::max(1, (gap * 10) / 13);  // Уменьшаем "шаг"
        swapped = false;

        for (int i = 0; i < n - gap; ++i) {
            if (arr[i] > arr[i + gap]) {
                std::swap(arr[i], arr[i + gap]);
                swapped = true;
            }
        }
    }
}


void heapify(std::vector<int>& arr, int n, int i) {
    int largest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && arr[left] > arr[largest]) {
        largest = left;
    }
    if (right < n && arr[right] > arr[largest]) {
        largest = right;
    }

    if (largest != i) {
        std::swap(arr[i], arr[largest]);
        heapify(arr, n, largest);
    }
}

void heapSort(std::vector<int>& arr) {
    int n = arr.size();

    for (int i = n / 2 - 1; i >= 0; --i) {
        heapify(arr, n, i);
    }

    for (int i = n - 1; i > 0; --i) {
        std::swap(arr[0], arr[i]);
        heapify(arr, i, 0);
    }
}

void bucketSort(std::vector<float>& arr) {
    int n = arr.size();
    std::vector<std::vector<float>> buckets(n);

    for (int i = 0; i < n; ++i) {
        int bucketIdx = n * arr[i];
        buckets[bucketIdx].push_back(arr[i]);
    }

    for (int i = 0; i < n; ++i) {
        std::sort(buckets[i].begin(), buckets[i].end());
    }

    int index = 0;
    for (int i = 0; i < n; ++i) {
        for (float num : buckets[i]) {
            arr[index++] = num;
        }
    }
}

// Функция для генерации массива
std::vector<int> generateArray(int size, const std::string& type) {
    std::vector<int> arr(size);
    if (type == "sorted") {
        for (int i = 0; i < size; ++i) arr[i] = i;
    } else if (type == "reverse") {
        for (int i = 0; i < size; ++i) arr[i] = size - i;
    } else {  // random
        for (int i = 0; i < size; ++i) arr[i] = rand() % 10000;
    }
    return arr;
}

// Тест Comb Sort
void testCombSort() {
    auto arr = generateArray(1000, "random");
    combSort(arr);  // Реализация из предыдущей части
    std::cout << "Comb Sort test passed!" << std::endl;
}
